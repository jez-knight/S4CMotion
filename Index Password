<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>S4C Motion</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎬</text></svg>">
<style>
  :root{color-scheme:dark}
  *{box-sizing:border-box}
  html,body{height:100%;margin:0}
  body{display:grid;place-items:center;background:#1A1617;color:#F4EFEF;font:14px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;padding:24px}
  .card{width:min(360px,100%);background:#241F20;border:1px solid #3A3334;border-radius:12px;padding:28px 26px 24px;box-shadow:0 18px 50px rgba(0,0,0,.5)}
  .mark{width:40px;height:40px;border-radius:8px;background:#FF4123;margin-bottom:16px}
  h1{font-size:18px;margin:0 0 4px}
  p{margin:0 0 18px;color:#B9AFB0;font-size:13px}
  label{display:block;font-size:12px;color:#B9AFB0;margin-bottom:6px}
  input{width:100%;height:40px;border-radius:6px;border:1px solid #3A3334;background:#1A1617;color:#F4EFEF;font:inherit;padding:0 12px}
  input:focus{outline:none;border-color:#FF4123;box-shadow:0 0 0 3px rgba(255,65,35,.25)}
  button{margin-top:14px;width:100%;height:40px;border:0;border-radius:6px;background:#FF4123;color:#fff;font:inherit;font-weight:700;cursor:pointer}
  button:hover{background:#FF5A3F}
  button:disabled{opacity:.6;cursor:wait}
  .err{min-height:20px;margin-top:10px;font-size:12px;color:#FF826B}
  .remember{display:flex;align-items:center;gap:8px;margin-top:12px;font-size:12px;color:#B9AFB0}
  .remember input{width:auto;height:auto}
</style>
</head>
<body>
<form class="card" id="f" autocomplete="off">
  <div class="mark" aria-hidden="true"></div>
  <h1>S4C Motion</h1>
  <p>Enter the password to open the app.</p>
  <label for="pw">Password</label>
  <input type="password" id="pw" autofocus required aria-describedby="err">
  <label class="remember"><input type="checkbox" id="rem" checked> Stay signed in until I close this tab</label>
  <button type="submit" id="go">Open</button>
  <div class="err" id="err" role="alert"></div>
</form>
<script>
(() => { // kept out of the page's global scope, which the app then shares
// The app below is encrypted (AES-GCM, key from the password with PBKDF2-SHA256), so without the password
// neither the page nor its source shows the app.
const D = { salt: "0Q4FJfI0eBItQvVhTSC8Gw==", iv: "YnzHczYxOwFlQS4o", iter: 600000, data: "" };
const KEY = "s4cmotion.unlock";
const bytes = s => Uint8Array.from(atob(s), c => c.charCodeAt(0));
async function keyFrom(pw){
  const base = await crypto.subtle.importKey("raw", new TextEncoder().encode(pw), "PBKDF2", false, ["deriveKey"]);
  return crypto.subtle.deriveKey({ name: "PBKDF2", salt: bytes(D.salt), iterations: D.iter, hash: "SHA-256" }, base, { name: "AES-GCM", length: 256 }, true, ["decrypt"]);
}
async function openApp(key){
  const plain = await crypto.subtle.decrypt({ name: "AES-GCM", iv: bytes(D.iv) }, key, bytes(D.data));
  const html = await new Response(new Blob([plain]).stream().pipeThrough(new DecompressionStream("gzip"))).text();
  document.open(); document.write(html); document.close();
}
const f = document.getElementById("f"), err = document.getElementById("err"), go = document.getElementById("go");
// already unlocked in this tab: open straight away
(async () => {
  try {
    const raw = sessionStorage.getItem(KEY); if (!raw) return;
    const key = await crypto.subtle.importKey("raw", bytes(raw), "AES-GCM", false, ["decrypt"]);
    await openApp(key);
  } catch(e){ sessionStorage.removeItem(KEY); }
})();
f.addEventListener("submit", async e => {
  e.preventDefault(); err.textContent = ""; go.disabled = true; go.textContent = "Opening…";
  try {
    const key = await keyFrom(document.getElementById("pw").value);
    if (document.getElementById("rem").checked){
      const raw = new Uint8Array(await crypto.subtle.exportKey("raw", key));
      sessionStorage.setItem(KEY, btoa(String.fromCharCode(...raw)));
    }
    await openApp(key);
  } catch(e){
    err.textContent = "That password isn’t right. Please try again.";
    go.disabled = false; go.textContent = "Open";
    const pw = document.getElementById("pw"); pw.select(); pw.focus();
  }
});
})();
</script>
</body>
</html>
